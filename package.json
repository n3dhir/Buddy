{
  "name": "buddy",
  "version": "0.1.0",
  "description": "Buddy — personal MCP server (v1: finance)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:api": "tsx src/web.ts",
    "dev:web": "npm run dev --prefix web",
    "build": "tsc && npm run build --prefix web",
    "start": "node dist/server.js",
    "start:web": "node dist/web.js",
    "migrate": "tsx ./node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts migrate:latest",
    "migrate:make": "tsx ./node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts migrate:make",
    "test:smoke": "tsx scripts/smoke.ts",
    "import:pg": "tsx scripts/import-sqlite-to-pg.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "pg": "^8.23.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
