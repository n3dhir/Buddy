DATABASE_URL="postgresql://user:password@localhost:5432/buddy"
PORT=3000
# Auth: open registration, password login -> session JWT (30d).
# API tokens (user-created, scoped, hashed) authorize machines/MCP.
# Signing secret. Generate: openssl rand -hex 32.
BUDDY_JWT_SECRET=""
# Telegram bot (webhook only, optional — bot stays off when unset).
# 1. Talk to @BotFather → /newbot → paste the token below.
# 2. Pick a secret and register the webhook:
#    curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<domain>/telegram/webhook?secret=<SECRET>"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Free-text parsing via Ollama (optional — commands always work).
# qwen3: disable thinking is handled in code (options.think=false).
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="qwen3:1.7b"
OLLAMA_TIMEOUT_MS="30000"
# Voice notes via local whisper.cpp (optional — text/commands never depend on it).
# Telegram sends Opus-in-OGG; ffmpeg converts to 16kHz WAV for whisper-cli.
WHISPER_BIN="/home/ubuntu/cloned-projects/whisper.cpp/build/bin/whisper-cli"
WHISPER_MODEL="/home/ubuntu/cloned-projects/whisper.cpp/models/ggml-small.bin"
WHISPER_LANG="en"
WHISPER_TIMEOUT_MS="60000"
VOICE_MAX_SECONDS="120"
